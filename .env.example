# ---- bac-demo .env.example ----
# Copy to .env (or export these before `node app/server.js`).
# NOTE: server.js does not auto-load .env; either export them or use a process
# manager. See INSTALL.md "Running" for the recommended launch command.

# --- OpenClaw gateway the bots talk to ---
# Local OpenClaw URL, token and agent IDs are discovered automatically.
# Set these only to override discovery, especially for a remote server.
GATEWAY_URL=
# Optional explicit token; otherwise read the OpenClaw configuration.
GATEWAY_TOKEN=
# Optional paths or agent IDs for an unusual installation:
# OPENCLAW_CONFIG_PATH=/path/to/openclaw.json
# GATEWAY_AGENT=my-agent
# GITHUB_AGENT=git

# --- Web server ---
PORT=8000

# --- Workspace that holds node_modules/playwright-core and ./scripts ---
# Defaults to the repo root, which is correct for the standard layout.
# WORKSPACE=/absolute/path/to/bac-demo

# --- GitHub demo target (GitHubAgent repo list + multi-agent PR) ---
# Startup defaults; the GitHub tab can select another repository at runtime.
GH_OWNER=your-github-username
GH_REPO=bac-demo
# Optional: startup PAT. app/.gh_token is also supported and takes precedence.
# Or enter a token in Connection settings -> GitHub, without a server restart.
GITHUB_TOKEN=

# --- Telegram two-way bridge bot (OPTIONAL) ---
# A SEPARATE bot from any OpenClaw Telegram integration. Create via @BotFather.
# Preferred: put the token in app/.tg_token instead of here.
TG_BOT_TOKEN=
# Required for startup Telegram connection: numeric destination Chat ID.
TG_CHAT_ID=

# Optional backend model override for all demo agents
# DEMO_MODEL=provider/model-id
# BROWSER_MODEL=provider/model-id
# HOST=127.0.0.1

# --- Browser showcase ---
# Start Chromium first with `npm run cdp` (see INSTALL.md).
BROWSER_CDP_URL=http://127.0.0.1:9222

# --- Optional AgentMail, or connect from the UI ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
