# Optional overrides. No .env file is required for ./bac start.
# Connect models/services in the UI, or save them in api.json for the next start.
# Uncomment only settings you need. Defaults work without this file.

# PORT=8000
# CHROME_EXECUTABLE=/path/to/chromium
# BROWSER_CDP_URL=http://127.0.0.1:9222
# BAC_API_CONFIG=/path/to/api.json

# Existing local OpenClaw is discovered automatically.
# Use these only for a remote gateway or an unusual local installation.
# GATEWAY_URL=https://your-gateway.example
# GATEWAY_TOKEN=
# OPENCLAW_CONFIG_PATH=/path/to/openclaw.json
# GATEWAY_AGENT=my-agent
# GITHUB_AGENT=git
# PM_AGENT=pm
# DEV_AGENT=dev
# DEMO_MODEL=provider/model-id
# BROWSER_MODEL=provider/model-id

# Legacy service environment variables remain supported; prefer api.json.
# GITHUB_TOKEN=
# GH_OWNER=
# GH_REPO=
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
